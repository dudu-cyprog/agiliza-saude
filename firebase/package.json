{
  "name": "agiliza-saude",
  "version": "2.0.0",
  "private": true,
  "description": "Agiliza Saude - Cidade Ocidental (GO) - Firebase (plano gratuito)",
  "scripts": {
    "emuladores": "firebase emulators:start --project demo-agiliza --import=emulator-data --export-on-exit",
    "seed": "node scripts/seed.js --emulador",
    "perfis": "node scripts/perfis-fakes.js",
    "test": "firebase emulators:exec --only firestore --project demo-agiliza \"node --test test/regras.test.js\"",
    "deploy": "firebase deploy --only hosting,firestore"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.14.1",
    "firebase-admin": "^12.6.0",
    "firebase-tools": "^13.29.1"
  }
}
